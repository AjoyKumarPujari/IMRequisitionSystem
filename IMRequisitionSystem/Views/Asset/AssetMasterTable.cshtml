</script>
<script>
    function ActivetoDeactive(Asset_Code_System, btnName) {

    debugger;

    Swal.fire({
        title: "Are you sure?",
        text: "",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "" + btnName
    }).then(function (result) {

        if (result.value) {

            var btnID = "activateButton";
            //var ID = ID;

            var assetsModel = {};
            assetsModel.Asset_Code_System = Asset_Code_System;

            $.ajax({
                url: '@Url.Action("ActiveDeactiveAssets", "Asset")',
                type: 'POST',
                data: { assetsModel: assetsModel },
                success: function (data) {

                    location.href = data.redirectUrl;

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    toastr.error("Failed. Try again.");
                }
            });

        }
    });

    }

    function ChangePhysicalCondition(Asset_Code_System) {

        debugger;

        Swal.fire({
            title: "Are you sure to update the Asset Physical Condition?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "" + "Update"
        }).then(function (result) {

            if (result.value) {

                var btnID = "activatePhysicalConditionButton";
                //var ID = ID;

                var assetsModel = {};
                assetsModel.Asset_Code_System = Asset_Code_System;

                $.ajax({
                    url: '@Url.Action("ChangePhysicalCondition", "Asset")',
                    type: 'POST',
                    data: { assetsModel: assetsModel },
                    success: function (data) {

                        location.href = data.redirectUrl;

                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        toastr.error("Failed. Try again.");
                    }
                });

            }
        });


    }
