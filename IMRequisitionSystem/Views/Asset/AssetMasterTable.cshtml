                 title: 'Asset Physical Condition',
                 orderable: false,
                 render: function (data, type, full, meta) {

                     if (data.Issue_status === "False" && data.asset_Physical_Condition === "DAMAGE") {
                         return '<span class="badge bg-primary text-white">Not Valid</span>';
                     } else if (data.Issue_status === "True") {
                         return '<span class="badge bg-warning text-white">Issued</span>';
                     } else {
                         return '<span class="badge bg-primary text-white">Available</span>';
                     }
                 },
             },
            
             {
                 targets: 18,
                 title: 'Active/De-Active',
                 orderable: false,
                 render: function (data, type, full, meta) {

                     return '<span style="font-size: 15px">' + (full.IsActive ? 'Active' : 'Deactive') + '</span>';

                 },
             },
             {
                 targets: 19,
                 title: 'Action',
                 orderable: false,
                 render: function (data, type, full, meta) {
                     var actionButtons = '';

                     // Deactivate button (if active)
                     if (data.IsActive === true) {
                         actionButtons += `
                <button class="btn btn-md btn-danger" onclick="ActivetoDeactive('${data.Asset_Code_System}', 'Dectivated')">
                    <span class="svg-icon svg-icon-white svg-icon-2x">
                        <!-- Close SVG -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24">
                            <g fill="none" fill-rule="evenodd">
                                <circle fill="#000000" opacity="0.3" cx="12" cy="12" r="10"/>
                                <path d="M12.035,10.621 L14.864,7.793 C15.254,7.402 15.888,7.402 16.278,7.793 C16.669,8.183 16.669,8.817 16.278,9.207 L13.45,12.036 L16.278,14.864 C16.669,15.254 16.669,15.888 16.278,16.278 C15.888,16.669 15.254,16.669 14.864,16.278 L12.036,13.45 L9.207,16.278 C8.817,16.669 8.183,16.669 7.793,16.278 C7.402,15.888 7.402,15.254 7.793,14.864 L10.621,12.036 L7.793,9.207 C7.402,8.817 7.402,8.183 7.793,7.793 C8.183,7.402 8.817,7.402 9.207,7.793 L12.036,10.621 Z" fill="#000000"/>
                            </g>
                        </svg>
                    </span>
                    Deactivate
                </button>`;
                     } else {
                         // Activate button (if not active)
                         actionButtons += `
                        <button class="btn btn-md btn-success mr-1" onclick="ActivetoDeactive('${data.Asset_Code_System}', 'Activate')">
                            <span class="svg-icon svg-icon-white svg-icon-2x">
                                <!-- Check SVG -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24">
                                    <g fill="none" fill-rule="evenodd">
                                        <circle fill="#000000" opacity="0.3" cx="12" cy="12" r="10"/>
                                        <path d="M16.769,7.818 C17.146,7.414 17.779,7.392 18.182,7.769 C18.586,8.146 18.608,8.779 18.231,9.182 L11.231,16.682 C10.865,17.074 10.256,17.108 9.849,16.759 L6.349,13.759 C5.93,13.4 5.881,12.769 6.241,12.349 C6.6,11.93 7.231,11.881 7.651,12.241 L10.423,14.617 L16.769,7.818 Z" fill="#000000"/>
                                    </g>
                                </svg>
                            </span>
                            Activate
                        </button>`;
                             }

                     // Change Physical Condition button
                     if (data.asset_Physical_Condition === "DAMAGE" && data.Issue_status === "False") {
                         actionButtons += `
                        <button class="btn btn-md btn-primary mr-1" onclick="ChangePhysicalCondition('${data.Asset_Code_System}')">
                            <span class="svg-icon svg-icon-white svg-icon-2x">
                                <!-- Check SVG -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="24px" height="24px" viewBox="0 0 24 24">
                                    <g fill="none" fill-rule="evenodd">
                                        <circle fill="#000000" opacity="0.3" cx="12" cy="12" r="10"/>
                                        <path d="M16.769,7.818 C17.146,7.414 17.779,7.392 18.182,7.769 C18.586,8.146 18.608,8.779 18.231,9.182 L11.231,16.682 C10.865,17.074 10.256,17.108 9.849,16.759 L6.349,13.759 C5.93,13.4 5.881,12.769 6.241,12.349 C6.6,11.93 7.231,11.881 7.651,12.241 L10.423,14.617 L16.769,7.818 Z" fill="#000000"/>
                                    </g>
                                </svg>
                            </span>
                            Change Physical Condition
                        </button>`;
                     }

                     // View/Update button
                     actionButtons += `
                     <button type="button" class="btn btn-primary btn-block mr-2 mb-1" onclick="GoToViewEditPage('${data.Asset_Code_System}')">Update</button>`;

                     return actionButtons;
                    // return '<button type="button" id="btnViewDetails" name="btnViewDetails" class="btn btn-primary btn-block mr-2 mb-1" onclick="GoToViewEditPage(\'' + data.Asset_Code_System + '\')"> Update </button>';
                 },
             },





         ],
         dom: '',
         //dom: '<"bottom" B>',
         buttons: [
             {
                 extend: 'excelHtml5',
                 text: 'Export to Excel',
                 filename: function () {
                     return 'AMC Mapping List';
                 }
             }
         ],
     });

     datatable_2 = datatable;

     $('#btnExportExcel').on('click', function () {
         datatable_2.button('.buttons-excel').trigger();
     });

 }



</script>






