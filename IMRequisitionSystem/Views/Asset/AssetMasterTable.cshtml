<script>

    $('#AssetModelNo').select2({
        placeholder: "Select Asset No"
    });
    $('#asset_Status').select2({
        placeholder: "Select Asset Status"
    });
    $('#LicenseNo').select2({
        placeholder: "Select License No"
    });

    $(document).ready(function () {

        AssetMasterListWithFilter();
        ShowTostr("@ViewBag.Status", "@ViewBag.Message");
    });


    var table = $('#IM_datatable');
    table.DataTable({
        responsive: true,
        scrollX: false,
        pagingType: 'full_numbers',
        order: [],
        dom: 'lBfrtip',
        buttons: [
            'copyHtml5',
            'excelHtml5',
            'csvHtml5',
            'pdfHtml5'
        ],
        lengthMenu: [
            [10, 25, 50, 100, -1],
            ['10 rows', '25 rows', '50 rows', '100 rows', 'Show all']
        ]
    });
    table.init();
</script>

<script>
