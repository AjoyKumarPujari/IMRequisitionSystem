                                        </div>

                                        <div class="col-lg-4 col-md-12 mt-2">
                                            <label class="font-weight-bolder ">
                                                AMC Vendor Code:
                                                <span class="text-danger">*</span>
                                            </label>
                                            <!-- <input class="form-control" type="text" id="AMCVC" />-->

                                            @Html.EditorFor(model => model.Latest_AMC_vendor_code, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", id = "AMCVC" } })

