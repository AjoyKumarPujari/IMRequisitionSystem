</script>

<script>
    $('#Role').select2({
        placeholder: "Select Role"
    });


    $('#AssetIDRPO').select2({
        placeholder: "Select Asset ID"
    });

    $('#AssetSerialNoRPO').select2({
        placeholder: "Select Asset Serial No"
    });


    $('#AssetIDSAPPO').select2({
        placeholder: "Select Asset ID"
    });

    $('#AssetSerialNoSAPPO').select2({
        placeholder: "Select Asset Serial No"
    });
   

</script>

<script>

    $(document).ready(function () {
        $(".AMCPO").hide();
        $(".AMCVD").hide();
        ShowTostr("@ViewBag.Status", "@ViewBag.Message");
    });


    $("#activateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Activate"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Activated",
                    "User has been activated successfully",
                    "success"
                )
                toggleDeactivateButton();
            }
        });
    });


    $("#deactivateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Deactivate"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Dectivated",
                    "User has been deactivated successfully",
                    "success"
                )
                toggleActivateButton();
            }
        });
    });


    $("#updateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Update"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Updated",
                    "User Role has been updated successfully",
                    "success"
                )
            }
        });
    });


    function toggleVisibility(hide) {

        //debugger;
        //const AMCVendorDetails = document.getElementById("AMCVD");
        const AMCVendorDetails = document.getElementsByClassName("AMCVD");


        if (hide === true) {
            //AMCVendorDetails.hidden = true;
            $(".AMCVD").hide();
        }
        else {
            //AMCVendorDetails.hidden = false;
            $(".AMCVD").show();
        }
        // Set the hidden property based on the radio button
    }

    function Hide() {
        $(".AMCVD").hide();
    }

    function toggleDeactivateButton() {
        const activateButton = document.getElementById('activateButton');
        const deactivateButton = document.getElementById('deactivateButton');
        activateButton.hidden = true;
        deactivateButton.hidden = false;

    }

    function toggleActivateButton() {
        const activateButton = document.getElementById('activateButton');
        const deactivateButton = document.getElementById('deactivateButton');
        activateButton.hidden = false;
        deactivateButton.hidden = true;
    }

    var validPONo = false;
    var verifyPoNoClicked = false;


    function VerifyPONo() {

        debugger;

        verifyPoNoClicked = true;

        $('#btnVerifyPONo').attr('disabled', true);
        $('#btnVerifyPONo').html('Please Wait...');

        var po_no = $('#AMCPONumber').val();

        $.ajax({
            url: "@Url.Action("GetDetailsByWorkOrderNoOfProductionServer", "Asset")",
            data: { Id: po_no },
            type: 'GET',
            success: function (workerDetails) {

                $('#btnVerifyPONo').attr('disabled', false);
                $('#btnVerifyPONo').html('Verify PO No');

                if (workerDetails.VendorName != null && workerDetails.VendorName != "" && workerDetails.VendorName != null && workerDetails.VendorName != "") {
                    validPONo = true;
                    toastr.success("PO No verified");
                    $('#AMCVC').val(workerDetails.VendorCode);
                    $('#AMCVN').val(workerDetails.VendorName);
                }
                else {
                    validPONo = false;
                    toastr.error("Not a valid PO No");
                    $('#AMCVC').val('');
                    $('#AMCVN').val('');
                }

            },
            error: function (jqXHR, textStatus, errorThrown) {

                validPONo = false;
                toastr.error("Not a valid PO No");
                $('#AMCVC').val('');
                $('#AMCVN').val('');

                $('#btnVerifyPONo').attr('disabled', false);
                $('#btnVerifyPONo').html('Verify PO No');
            }
        });

    }

    function GetAssetDataBySAPID() {

     debugger;



     var asset_sap_id = $('#Asset_Id_SAP').val();
         debugger;
     $.ajax({
         url: "@Url.Action("GetAssetsDataBySAPID", "Asset")",
         data: { Id: asset_sap_id },
         type: 'GET',
         success: function (assetDetails) {



             $('#Asset_Sl_No').val(assetDetails.Asset_Sl_No);
             $('#AssetMakeNo').val(assetDetails.AssetMakeNo);
             $('#AssetModelNo').val(assetDetails.AssetModelNo);
             $('#Installation_date').val(assetDetails.Installation_date);
             $('#DeviceType').val(assetDetails.DeviceType);
             $('#asset_custodian_department').val(assetDetails.asset_custodian_department);
             $('#Latest_AMC_vendor_code').val(assetDetails.Latest_AMC_vendor_code);
             $('#Latest_AMC_vendorname').val(assetDetails.Latest_AMC_vendorname);


         },
         error: function (jqXHR, textStatus, errorThrown) {

             toastr.error("Not a valid AssetID");
             $('#Asset_Sl_No').val('');
             $('#AssetMakeNo').val('');
             $('#AssetModelNo').val('');
             $('#Installation_date').val('');
             $('#DeviceType').val('');
             $('#asset_custodian_department').val('');
             $('#Latest_AMC_vendor_code').val('');
             $('#Latest_AMC_vendorname').val('');

         }
     });

 }

    function VerifyPONoForAMC() {

     debugger;

     verifyPoNoClicked = true;

      $('#btnVerifyPONoForAMC').attr('disabled', true);
      $('#btnVerifyPONoForAMC').html('Please Wait...');

      var po_no = $('#PO_No_For_AMC').val();

     $.ajax({
         url: "@Url.Action("GetDetailsByWorkOrderNoOfProductionServer", "Asset")",
         data: { Id: po_no },
         type: 'GET',
         success: function (workerDetails) {

             $('#btnVerifyPONoForAMC').attr('disabled', false);
             $('#btnVerifyPONoForAMC').html('Verify PO No');

             if (workerDetails.VendorName != null && workerDetails.VendorName != "" && workerDetails.VendorName != null && workerDetails.VendorName != "") {
                 validPONo = true;
                 toastr.success("PO No verified");
                 $('#Vendor_code_For_AMC').val(workerDetails.VendorCode);
                 $('#Vendor_name_For_AMC').val(workerDetails.VendorName);
             }
             else {
                 validPONo = false;
                 toastr.error("Not a valid PO No");
                 $('#Vendor_code_For_AMC').val('');
                 $('#Vendor_name_For_AMC').val('');
             }

         },
         error: function (jqXHR, textStatus, errorThrown) {

             validPONo = false;
             toastr.error("Not a valid PO No");
             $('#Vendor_code_For_AMC').val('');
             $('#Vendor_name_For_AMC').val('');

             $('#btnVerifyPONoForAMC').attr('disabled', false);
             $('#btnVerifyPONoForAMC').html('Verify PO No');
         }
     });

 }

    function GetAssetDataBySAPIDFORRPO() {

    debugger;



    var asset_sap_id = $('#Asset_Id_SAP').val();
        debugger;
    $.ajax({
        url: "@Url.Action("GetAssetsDataBySAPID", "Asset")",
        data: { Id: asset_sap_id },
        type: 'GET',
        success: function (assetDetails) {



            $('#Asset_Sl_No').val(assetDetails.Asset_Sl_No);
            $('#AssetMakeNo').val(assetDetails.AssetMakeNo);
            $('#AssetModelNo').val(assetDetails.AssetModelNo);
            $('#Installation_date').val(assetDetails.Installation_date);
            $('#DeviceType').val(assetDetails.DeviceType);
            $('#asset_custodian_department').val(assetDetails.asset_custodian_department);
            $('#Latest_AMC_vendor_code').val(assetDetails.Latest_AMC_vendor_code);
            $('#Latest_AMC_vendorname').val(assetDetails.Latest_AMC_vendorname);


        },
        error: function (jqXHR, textStatus, errorThrown) {

            toastr.error("Not a valid AssetID");
            $('#Asset_Sl_No').val('');
            $('#AssetMakeNo').val('');
            $('#AssetModelNo').val('');
            $('#Installation_date').val('');
            $('#DeviceType').val('');
            $('#asset_custodian_department').val('');
            $('#Latest_AMC_vendor_code').val('');
            $('#Latest_AMC_vendorname').val('');

        }
    });

}

    function ValidatePOShow(hide) {
        if (hide === true) {
            $(".AMCPO").hide();
            document.getElementById("AMCVC").readOnly = false;
            document.getElementById("AMCVN").readOnly = false;
            document.getElementById("AMCVC").value = "";
            document.getElementById("AMCVN").value = "";
            document.getElementById("AMCPONumber").value = "";
        }
        else {
            $(".AMCPO").show();
            document.getElementById("AMCVC").readOnly = true;
            document.getElementById("AMCVN").readOnly = true;
        }
    }

</script>






