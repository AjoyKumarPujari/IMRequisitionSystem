                                            </label>

                                            <!--  <input class="form-control" type="text" id="AMCVN" /> -->
                                            @Html.EditorFor(model => model.Latest_AMC_vendorname, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", id = "AMCVN" } })

                                            <span class="form-text text-muted">AMC Vendor Name.</span>
                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label>
                                                AMC Start Date:
                                                <span class="text-danger">*</span>
                                            </label>

                                            <div class="input-group date">
                                                @Html.EditorFor(model => model.Latest_AMC_Start_Date, new { htmlAttributes = new { id = "Requisition_Date", placeholder = "Select IRequisition_ Date", @class = "form-control", @type = "date" } })


                                            </div>

                                        </div>
                                         <div class="form-group col-lg-4">
                                            <label>
                                                AMC End Date:
                                                <span class="text-danger">*</span>
                                            </label>

                                            <div class="input-group date">
                                                @Html.EditorFor(model => model.Latest_AMC_End_Date, new { htmlAttributes = new { id = "Requisition_Date", placeholder = "Select IRequisition_ Date", @class = "form-control", @type = "date" } })


                                            </div>

                                        </div>

                                    </div>

                                    <div class="row mt-5">

                                        <div class="col-lg-6">

