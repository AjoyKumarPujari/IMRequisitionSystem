                                                </label>
                                                <label class="radio radio-outline radio-success">
                                                    <input type="radio" name="toggle" value="show" onclick="ValidatePOShow(false)" />
                                                    <span></span>
                                                    SAP PO
                                                </label>
                                            </div>

                                            <span class="form-text text-muted">Is this a SAP PO or RPO?</span>
                                        </div>


                                        <div class="col-lg-4 col-md-12 mt-2">
                                            <label class="font-weight-bolder">
                                                AMC PO Number:
                                                <span class="text-danger">*</span>
                                            </label>
                                            <!--<input class="form-control" type="text"  id="AMCPONumber"/>-->
