                                            @Html.HiddenFor(model => model.Asset_Code_System, new { htmlAttributes = new { @type = "text", @class = "form-control from-control-solid", @placeholder = "Enter PO No", autocomplete = "off", @readonly = "readonly" } })

                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">
                                                Asset Serial No:
                                                <span class="text-danger">*</span>
                                            </label>
                                            @Html.EditorFor(model => model.Asset_Sl_No, new { htmlAttributes = new { @type = "text", @class = "form-control from-control-solid", @placeholder = "", style = "width:100%", autocomplete = "off", @readonly = "readonly" } })
                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">PO Number</label>

                                            @Html.EditorFor(model => model.PO_No, new { htmlAttributes = new { @type = "text", @class = "form-control from-control-solid", @placeholder = "Enter PO No", autocomplete = "off", @readonly = "readonly" } })


