

@model IMRequisitionSystem.Models.Assets.AssetsModel
@{
    ViewBag.Title = "AMCMappingRPOPage";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="d-flex flex-column-fluid" style="margin-top:-30px">
    <div class="container-fluid">


        <div class="card card-custom gutter-b" style="border-radius: 25px;">

            <div class="card-header card-header-tabs-line">
                <div class="card-title d-flex justify-content-between align-items-center w-100">
                    <div class="card-toolbar">
                        <h2>AMC Mapping with RPO Number</h2>
                    </div>
                    <button onclick="location.href='@Url.Action("AMCMappingList", "Home")'" class="btn btn-primary d-flex align-items-center">
