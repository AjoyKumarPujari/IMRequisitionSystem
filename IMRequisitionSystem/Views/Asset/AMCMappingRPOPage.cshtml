                                </g>
                            </svg>
                            <!--end::Svg Icon-->
                        </span>
                        AMC MAPPING LIST
                    </button>

                </div>
            </div>

            <div class="card-body">

                <div class="tab-content">
                    @using (Html.BeginForm("AMCMappingRPOPage", "Asset", FormMethod.Post, new { enctype = "multipart/form-data", id = "createAssetMasterAMCRPO" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="tab-pane show" id="kt_tab_pane_2_4" role="tabpanel" aria-labelledby="kt_tab_pane_2_4">
                            <form class="form">

                                <div class="card-body">

                                    <div class="row">

                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">PO Number</label>
                                            @Html.EditorFor(model => model.PO_No, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                            <span class="form-text text-muted">Enter the RPO Number.</span>
                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder"> Asset ID:<span class="text-danger">*</span></label>
                                            @Html.DropDownListFor(model => model.Asset_Id_SAP, new SelectList(ViewBag.AssetMasterDataDD, "Asset_Code_System", "Asset_Id_SAP"), "Select Device Type", new { @class = "form-control select2", @style = "width:100%", onchange = "GetAssetDataBySAPID('Asset_Code_System')" })
                                            <span class="form-text text-muted">Select Asset ID</span>
                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder"> Asset Serial No: <span class="text-danger">*</span> </label>
                                            @Html.EditorFor(model => model.Asset_Sl_No, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                            <span class="form-text text-muted">Select Asset Serial Number</span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">Make</label>
                                            @Html.EditorFor(model => model.AssetMakeNo, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">Model</label>
                                            @Html.EditorFor(model => model.AssetModelNo, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">Installation Date</label>
                                            @Html.EditorFor(model => model.Installation_date, new { htmlAttributes = new { id = "Installation_Date", placeholder = "Select Date", @class = "form-control", @type = "date" } })
                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">Category</label>
                                            @Html.EditorFor(model => model.DeviceType, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })

                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">Current Location</label>
                                            @Html.EditorFor(model => model.asset_custodian_department, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>
                                        <div class="form-group col-lg-4" id="VC">
                                            <label class="font-weight-bolder"> Supplier Vendor Code<span class="text-danger"></span></label>
                                            @Html.EditorFor(model => model.Latest_AMC_vendor_code, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>
                                        <div class="form-group col-lg-4" id="VN">
                                            <label class="font-weight-bolder">
                                                Supplier Vendor Name
                                            </label>
                                            @Html.EditorFor(model => model.Latest_AMC_vendorname, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>
                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">
                                                Supplier AMC Expiry
                                            </label>
                                            @Html.EditorFor(model => model.Latest_AMC_expiry, new { htmlAttributes = new { id = "Installation_Date", placeholder = "Select Date", @class = "form-control", @type = "date" } })
                                        </div>
                                        <div class="col-lg-4">
                                            <label class="font-weight-bolder">AMC PO same as Procurement PO:</label>
                                            <div class="radio-inline">
                                                <label class="radio radio-outline radio-success">
                                                    <input type="radio" name="toggle" value="hide" onclick="toggleVisibility(true)" checked />
                                                    <span></span>
                                                    Yes
                                                </label>
                                                <label class="radio radio-outline radio-success">
                                                    <input type="radio" name="toggle" value="show" onclick="toggleVisibility(false)" />
                                                    <span></span>
                                                    No
                                                </label>
                                            </div>
                                            <span class="form-text text-muted">Is AMC PO same as Procurement PO?</span>
                                        </div>
                                    </div>

                                    <div class="row AMCVD" id="AMCVD">

                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder"> AMC PO Number</label>
                                            @Html.EditorFor(model => model.PO_No_For_AMC, new { htmlAttributes = new { @type = "text", @class = "form-control ", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                            <span class="form-text text-muted">Enter the AMC PO Number.</span>
                                        </div>

                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">
                                                AMC Vendor Code
                                            </label>
                                            @Html.EditorFor(model => model.Vendor_code_For_AMC, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>

                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">
                                                AMC Vendor Name
                                            </label>
                                            @Html.EditorFor(model => model.Vendor_name_For_AMC, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "", style = "width:100%", autocomplete = "off", } })
                                        </div>

                                        <div class="form-group col-lg-4">
                                            <label class="font-weight-bolder">
                                                AMC Expiry Date
                                            </label>
                                            @Html.EditorFor(model => model.AMC_expiry_For_AMC, new { htmlAttributes = new { id = "Installation_Date", placeholder = "Select Date", @class = "form-control", @type = "date" } })
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer">

                                    <div class="row">

                                        <div class="col-lg-6">

                                            <button type="submit" id="btnSubmit" name="btnSubmit" class="btn btn-sm btn-primary mr-2">
                                                <span class="svg-icon svg-icon-white svg-icon-2x">
                                                    <!--begin::Svg Icon | path:C:\wamp64\www\keenthemes\themes\metronic\theme\html\demo1\dist/../src/media/svg/icons\General\Save.svg--><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                            <polygon points="0 0 24 0 24 24 0 24" />
                                                            <path d="M17,4 L6,4 C4.79111111,4 4,4.7 4,6 L4,18 C4,19.3 4.79111111,20 6,20 L18,20 C19.2,20 20,19.3 20,18 L20,7.20710678 C20,7.07449854 19.9473216,6.94732158 19.8535534,6.85355339 L17,4 Z M17,11 L7,11 L7,4 L17,4 L17,11 Z" fill="#000000" fill-rule="nonzero" />
                                                            <rect fill="#000000" opacity="0.3" x="12" y="4" width="3" height="5" rx="0.5" />
                                                        </g>
                                                    </svg><!--end::Svg Icon-->
                                                </span>
                                                Map AMC
                                            </button>

                                            <button type="button" id="btnGenerate" name="btnGenerate" class="btn btn-sm btn-warning">
                                                <span class="svg-icon svg-icon-white svg-icon-2x">
                                                    <!--begin::Svg Icon | path:C:\wamp64\www\keenthemes\themes\metronic\theme\html\demo1\dist/../src/media/svg/icons\Media\Repeat.svg--><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="24px" height="24px" viewBox="0 0 24 24" version="1.1">
                                                        <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                                                            <rect x="0" y="0" width="24" height="24" />
                                                            <path d="M12,8 L8,8 C5.790861,8 4,9.790861 4,12 L4,13 C4,14.6568542 5.34314575,16 7,16 L7,18 C4.23857625,18 2,15.7614237 2,13 L2,12 C2,8.6862915 4.6862915,6 8,6 L12,6 L12,4.72799742 C12,4.62015048 12.0348702,4.51519416 12.0994077,4.42878885 C12.264656,4.2075478 12.5779675,4.16215674 12.7992086,4.32740507 L15.656242,6.46136716 C15.6951359,6.49041758 15.7295917,6.52497737 15.7585249,6.56395854 C15.9231063,6.78569617 15.876772,7.09886961 15.6550344,7.263451 L12.798001,9.3840407 C12.7118152,9.44801079 12.607332,9.48254921 12.5,9.48254921 C12.2238576,9.48254921 12,9.25869158 12,8.98254921 L12,8 Z" fill="#000000" />
                                                            <path d="M12.0583175,16 L16,16 C18.209139,16 20,14.209139 20,12 L20,11 C20,9.34314575 18.6568542,8 17,8 L17,6 C19.7614237,6 22,8.23857625 22,11 L22,12 C22,15.3137085 19.3137085,18 16,18 L12.0583175,18 L12.0583175,18.9825492 C12.0583175,19.2586916 11.8344599,19.4825492 11.5583175,19.4825492 C11.4509855,19.4825492 11.3465023,19.4480108 11.2603165,19.3840407 L8.40328311,17.263451 C8.18154548,17.0988696 8.13521119,16.7856962 8.29979258,16.5639585 C8.32872576,16.5249774 8.36318164,16.4904176 8.40207551,16.4613672 L11.2591089,14.3274051 C11.48035,14.1621567 11.7936615,14.2075478 11.9589099,14.4287888 C12.0234473,14.5151942 12.0583175,14.6201505 12.0583175,14.7279974 L12.0583175,16 Z" fill="#000000" opacity="0.3" />
                                                        </g>
                                                    </svg><!--end::Svg Icon-->
                                                </span>
                                                Reset
                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </form>
                        </div>
                    }
                </div>
            </div>

        </div>

    </div>

</div>

