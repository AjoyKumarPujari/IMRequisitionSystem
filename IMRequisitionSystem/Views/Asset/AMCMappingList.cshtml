<script>
   jQuery(document).ready(function () {
       AMCMappingListWithFilter();
   ShowTostr("@ViewBag.Status", "@ViewBag.Message");
});
</script>

<script>

    $('#Asset_Id_SAP').select2({
        placeholder: "Select Asset ID"
    });

    $('#PO_No').select2({
        placeholder: "Select PO Number"
    });

    $('#Asset_Sl_No').select2({
        placeholder: "Select Asset Serial No"
    });

</script>

<script>
    $("#activateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Activate"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Activated",
                    "User has been activated successfully",
                    "success"
                )
                toggleDeactivateButton();
            }
        });
    });


    $("#deactivateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Deactivate"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Dectivated",
                    "User has been deactivated successfully",
                    "success"
                )
                toggleActivateButton();
            }
        });
    });


    $("#updateButton").click(function (e) {
        Swal.fire({
            title: "Are you sure?",
            text: "",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Update"
        }).then(function (result) {
            if (result.value) {
                Swal.fire(
                    "Updated",
                    "User Role has been updated successfully",
                    "success"
                )
            }
        });
    });


    function toggleDeactivateButton() {
        const activateButton = document.getElementById('activateButton');
        const deactivateButton = document.getElementById('deactivateButton');
        activateButton.hidden = true;
        deactivateButton.hidden = false;

    }

    function toggleActivateButton() {
        const activateButton = document.getElementById('activateButton');
        const deactivateButton = document.getElementById('deactivateButton');
        activateButton.hidden = false;
        deactivateButton.hidden = true;
    }

    function ValidatePOHide() {
        $(".AMCPO").hide();
    }

    function ValidatePOShow(hide) {
        if (hide === true) {
            $(".AMCPO").hide();
            document.getElementById("AMCVC").disabled = false;
            document.getElementById("AMCVN").disabled = false;
        }
        else {
            $(".AMCPO").show();
            document.getElementById("AMCVC").disabled = true;
            document.getElementById("AMCVN").disabled = true;
        }
    }


    function GoToViewEditPage(asset_Code_System) {
     debugger;
    $.ajax({
     url: "@Url.Action("SetSession_Asset_Code_System", "Common")",
     type: 'POST',
        data: { key: "asset_Code_System", asset_Code_System: asset_Code_System },
     success: function (response) {

         if (response.success) {
             //var url = $('base').attr('href') + "DetailsPageForHODUnitInCharge";
             var url ='@Url.Action("AMCMappingPageEdit", "Asset")';
         window.location.href = url;
         }
     },
     error: function () {
     }
     });
    }

    function clearForm() {

        $("#PO_No").val(" ").change();;
        $("#Asset_Sl_No").val(" ").change();;
        $("#Asset_Id_SAP").val(" ").change();;
        AMCMappingListWithFilter();
    }

    function AMCMappingListWithFilter() {
        var i = 1;
        debugger;
        var AssetsModel = {};
        AssetsModel.PO_No = $('#PO_No').val();
        AssetsModel.Asset_Sl_No = $('#Asset_Sl_No').val();
        AssetsModel.Asset_Id_SAP = $('#Asset_Id_SAP').val();
        var url ='@Url.Action("GetAMCMappingListWithFilter", "Asset")';

        var datatable = $('#IM_datatable').DataTable({
            destroy: true,
            scrollX: false,
            responsive: true,
            paging: false,
            pagingType: 'full_numbers',
            ajax: {
                url: url,
                type: 'POST',
                data: { assetModel: AssetsModel },
                dataSrc: '',
            },
            columns: [

                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },
                { data: null },


            ],
            columnDefs: [


                {
                    targets: 0,
                    title: 'Sl No',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + i + '</span>';
                        i++
                    },
                },
                {
                    targets: 1,
                    title: 'Asset SAP ID',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.Asset_Id_SAP + '</span>';
                    },
                },
                {
                    targets: 2,
                    title: 'Asset Sl No ',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.Asset_Sl_No + '</span>';
                    },
                },
                {
                    targets: 3,
                    title: 'Make  ',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.AssetMakeNo + '</span>';
                    },
                },
                {
                    targets: 4,
                    title: 'Model  ',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.AssetModelNo + '</span>';
                    },
                },
                {
                    targets: 5,
                    title: 'Device Category  ',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.DeviceType + '</span>';
                    },
                },
                {
                    targets: 6,
                    title: 'AMC Vendor Code',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.Latest_AMC_vendor_code + '</span>';
                    },
                },
                {
                    targets: 7,
                    title: 'AMC Vendor Name',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.Latest_AMC_vendorname + '</span>';
                    },
                },
                {
                    targets: 8,
                    title: 'AMC Expiry Date',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<span style="font-size: 15px">' + data.Latest_AMC_expiry + '</span>';
                    },
                },
                {
                    targets: 9,
                    title: 'Action',
                    orderable: false,
                    render: function (data, type, full, meta) {

                        return '<button type="button" id="btnViewDetails" name="btnViewDetails" class="btn btn-primary btn-block mr-2 mb-1" onclick="GoToViewEditPage(\'' + data.Asset_Code_System + '\')"> Update </button>';
                    },
                },





            ],
            dom: '',
            //dom: '<"bottom" B>',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: 'Export to Excel',
                    filename: function () {
                        return 'AMC Mapping List';
                    }
                }
            ],
        });

        datatable_2 = datatable;

        $('#btnExportExcel').on('click', function () {
            datatable_2.button('.buttons-excel').trigger();
        });

    }

</script>

