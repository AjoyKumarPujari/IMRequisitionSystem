<script>
    function ActivetoDeactive(Mapping_Id, btnName) {

    debugger;

    Swal.fire({
        title: "Are you sure?",
        text: "",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "" + btnName
    }).then(function (result) {

        if (result.value) {

            var btnID = "activateButton";

            var roleMappingModel = {};
            roleMappingModel.Mapping_Id = Mapping_Id;

            $.ajax({
                url: '@Url.Action("ActiveDeactiveLocationRoleMapping", "RoleMaster")',
                type: 'POST',
                data: { roleMappingModel: roleMappingModel },
                success: function (data) {

                    location.href = data.redirectUrl;

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    toastr.error("Failed. Try again.");
                }
            });

        }
    });

    }


    function SortCloseByIssuer() {
        debugger;
        var btnID = "sortClose";
        var requisition_No = $("#Requisition_No").val();
        var closed_Remarks = $("#Closed_Remarks").val();

        if (closed_Remarks == "" || closed_Remarks == null) {
            showSwalToast("Closed Remarks is required.", "error");
            return;
        }

        $("#" + btnID).attr("disabled", true);
        $("#" + btnID).html("Please Wait..");

        var requisitionRequestModel = {};
        requisitionRequestModel.Requisition_No = requisition_No;
        requisitionRequestModel.Closed_Remarks = closed_Remarks;

        $.ajax({
            url: '@Url.Action("RequisitionSortCloseByIssuer", "Issuer")',
            type: 'POST',
            data: { requisitionRequestModel: requisitionRequestModel },
            success: function (data) {

                if (data.redirectUrl != '') {
                    location.href = data.redirectUrl;
                } else {
                    $("#" + btnID).attr("disabled", false);
                    $("#" + btnID).html("Submit");
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {

                $("#" + btnID).attr("disabled", false);
                $("#" + btnID).html("Submit");

                toastr.error("Failed to Approve. Try again.");
            }
        });
    }
</script>
<script>


    function ArchiveData(Mapping_Id) {
    debugger;
    var btnID = "archiveButton";
    var mapping_ID = Mapping_Id;

    if (!mapping_ID) {
        toastr.error("Invalid Mapping ID.");
        return;
    }

    Swal.fire({
        title: "Are you sure?",
        text: "This action will archive the data.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, Archive"
    }).then(function (result) {
        if (result.isConfirmed) {
            $("#" + btnID).attr("disabled", true).html("Please Wait..");

            var roleMappingModel = { Mapping_Id: mapping_ID };

            $.ajax({
                url: '@Url.Action("RoleLocationMappingArchive", "RoleMaster")',
                type: 'POST',
                data: JSON.stringify(roleMappingModel),
                contentType: "application/json",
                success: function (data) {
                    if (data.redirectUrl) {
                        location.href = data.redirectUrl;
                    } else {
                        $("#" + btnID).attr("disabled", false).html("Submit");
                        toastr.success("Archived Successfully");
                    }
                },
                error: function () {
                    $("#" + btnID).attr("disabled", false).html("Submit");
                    toastr.error("Failed to Archive. Try again.");
                }
            });
        }
    });
}

</script>



